<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NOTE: Giao diện áp dụng khi tiến trình khởi động và chế độ tối đang tắt. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Hiển thị splash screen; tự gỡ khi Flutter vẽ khung hình đầu tiên. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- NOTE: Giao diện nền cửa sổ Android khi Flutter khởi tạo và đang chạy.
         Chỉ dùng với Android embedding V2 của Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
